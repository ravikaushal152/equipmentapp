# Copy this file to .env for local development.
# NEVER commit your real .env file or API key to GitHub.

# Required for live Gemini AI features (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model to use (gemini-3.5-flash-lite is fast and free-tier friendly)
GEMINI_MODEL=gemini-3.5-flash-lite

# SQLite database path (created and seeded automatically on first boot)
LABLINK_DB_PATH=data/lablink.db

# Application environment
LABLINK_ENV=development
PORT=8080
